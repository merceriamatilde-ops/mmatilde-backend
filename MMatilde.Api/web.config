<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules>
      <!-- Elimina el módulo WebDAV de IIS, que por defecto bloquea las peticiones PUT y DELETE -->
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <!-- Elimina el manejador WebDAV para asegurar que las peticiones lleguen a ASP.NET Core -->
      <remove name="WebDAV" />
    </handlers>
  </system.webServer>
</configuration>
